{
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "BotArena": "Host=localhost;Port=5432;Database=botarena;Username=admin;Password=admin"
  },
  "Database": { "MigrateOnStartup": true },
  "Authentication": {
    "OAuth": {
      "Providers": {
        "yandex": {
          "DisplayName": "Яндекс ID", "Badge": "Я", "Color": "#fc3f1d",
          "ClientId": "", "ClientSecret": "", "CallbackPath": "/auth/callback",
          "AuthorizationEndpoint": "https://oauth.yandex.ru/authorize",
          "TokenEndpoint": "https://oauth.yandex.ru/token",
          "UserInformationEndpoint": "https://login.yandex.ru/info?format=json",
          "Scopes": [ "login:info", "login:avatar" ],
          "AuthorizationHeaderScheme": "OAuth", "SubjectField": "id",
          "FirstNameField": "first_name", "LastNameField": "last_name",
          "AvatarField": "default_avatar_id",
          "AvatarUrlTemplate": "https://avatars.yandex.net/get-yapic/{0}/islands-200"
        },
        "github": {
          "DisplayName": "GitHub", "Badge": "GH", "Color": "#24292f",
          "ClientId": "", "ClientSecret": "", "CallbackPath": "/auth/github/callback",
          "AuthorizationEndpoint": "https://github.com/login/oauth/authorize",
          "TokenEndpoint": "https://github.com/login/oauth/access_token",
          "UserInformationEndpoint": "https://api.github.com/user",
          "Scopes": [ "read:user" ], "UserAgent": "BotArena",
          "SubjectField": "id", "NameField": "name", "AvatarField": "avatar_url"
        },
        "google": {
          "DisplayName": "Google", "Badge": "G", "Color": "#4285f4",
          "ClientId": "", "ClientSecret": "", "CallbackPath": "/auth/google/callback",
          "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
          "TokenEndpoint": "https://oauth2.googleapis.com/token",
          "UserInformationEndpoint": "https://openidconnect.googleapis.com/v1/userinfo",
          "Scopes": [ "openid", "profile" ], "SubjectField": "sub",
          "FirstNameField": "given_name", "LastNameField": "family_name",
          "NameField": "name", "AvatarField": "picture"
        }
      }
    }
  }
}
